{
  "name": "kacung-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kacung — Native macOS AI Agent Voice Assistant",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "SAFE_TEST_MODE=true LIVE_SIDE_EFFECTS=false vitest run",
    "test:watch": "SAFE_TEST_MODE=true LIVE_SIDE_EFFECTS=false vitest",
    "test:integration": "SAFE_TEST_MODE=true LIVE_SIDE_EFFECTS=false vitest run tests/",
    "dev": "SAFE_TEST_MODE=true LIVE_SIDE_EFFECTS=false pnpm dev:agent",
    "dev:agent": "pnpm --filter @kacung/agent run dev",
    "dev:live": "pnpm --filter @kacung/agent run dev",
    "build:macos": "swift build --package-path apps/macos",
    "clean": "pnpm --recursive run clean && rimraf dist"
  },
  "devDependencies": {
    "@kacung/config": "workspace:*",
    "@kacung/core": "workspace:*",
    "@kacung/tools": "workspace:*",
    "@kacung/types": "workspace:*",
    "@types/node": "^22.13.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
