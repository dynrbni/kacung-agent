# 9Router OpenAI-compatible API Configuration
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ag/gemini-3.8-flash-high

# Optional: Server Port & Host
PORT=3847
HOST=127.0.0.1

# Optional: Assistant Identity
ASSISTANT_NAME=Lofly
WAKE_PHRASE="Woi Lofly"
DEFAULT_LANGUAGES=id,en
HOTKEY_FALLBACK="Option+Space"

# Safe Testing & Side-Effect Protection
# Development and test runs are safe by default. Tools with a side effect are
# simulated (dry run) instead of executed.
LOFLY_ENV=development
SAFE_TEST_MODE=true
LIVE_SIDE_EFFECTS=false
# Optional: dry_run (default) | sandbox | live — sandbox confines filesystem
# writes to LOFLY_SANDBOX_ROOT instead of the real user files.
LOFLY_EXECUTION_MODE=dry_run
LOFLY_SANDBOX_ROOT=~/LoflySandbox

# Security Policy
CONFIRM_SENSITIVE_ACTIONS=true
CONFIRM_DANGEROUS_ACTIONS=true

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
