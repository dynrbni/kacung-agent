# ==============================================================================
# Kacung Configuration
# Native macOS AI Agent Voice Assistant
# ==============================================================================

# Server Runtime
PORT=3847
HOST=127.0.0.1
LOG_LEVEL=info

# LLM Providers (Choose one or configure fallback: gemini | openai | anthropic | ollama | mock)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (Local LLM fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Speech-to-Text (STT) Provider: apple | whisper | groq | mock
STT_PROVIDER=apple
GROQ_API_KEY=

# Text-to-Speech (TTS) Provider: macos | openai | elevenlabs
# 'macos' uses native macOS speech synthesis ("say" command / AVSpeechSynthesizer)
TTS_PROVIDER=macos
TTS_VOICE=Damayanti

# Assistant Persona & Language
ASSISTANT_NAME=Kacung
WAKE_PHRASE="Woi Kacung"
DEFAULT_LANGUAGES=id,en
HOTKEY_FALLBACK="Option+Space"

# Security & Safety
# SAFE: Execute without prompt
# SENSITIVE: Prompt user confirmation unless explicitly allowed
# DANGEROUS: Always prompt user confirmation
CONFIRM_SENSITIVE_ACTIONS=true
CONFIRM_DANGEROUS_ACTIONS=true
