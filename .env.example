# 9Router OpenAI-compatible API Configuration
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ag/gemini-3.8-flash-high

# Optional: Server Port & Host
PORT=3847
HOST=127.0.0.1

# Optional: Assistant Identity
ASSISTANT_NAME=Kacung
WAKE_PHRASE="Woi Kacung"
DEFAULT_LANGUAGES=id,en
HOTKEY_FALLBACK="Option+Space"

# Security Policy
CONFIRM_SENSITIVE_ACTIONS=true
CONFIRM_DANGEROUS_ACTIONS=true

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
